! Post-process: resume solved model, report contact pressure & reaction
resume,tonometer_offset,db
/post1
set,last
! Reaction force at fixed support (total Y reaction = load reaching the eye)
fsum
*get,fy_reac,fsum,0,item,fy
/com,======================================================
/com,=== TOTAL Y REACTION AT SUPPORTS = %fy_reac% N ===
/com,======================================================
! Contact pressure on Contact Region 3 (real 9 = eyelid contact elems)
esel,s,real,,9
etable,cpres,cont,pres
etable,cgap,cont,gap
esort,etab,cpres,0,1
*get,cp_max,etab,0,etab,cpres,max
esort,etab,cgap
*get,gap_min,etab,0,etab,cgap,min
*get,gap_max,etab,0,etab,cgap,max
/com,=== Contact Region 3: MAX CONTACT PRESSURE = %cp_max% Pa ===
/com,=== Contact Region 3: GAP range = [%gap_min% , %gap_max%] m ===
! Number of contact elements in closed status
etable,cstat,cont,stat
ssum
*get,stat_sum,ssum,0,item,cstat
/com,=== Sum of contact status (>=1 means closed elems exist) = %stat_sum% ===
! Max UY on eyelid (body 3, mat 3) - did it get pushed?
allsel
esel,s,mat,,3
nsle,s
nsort,u,y
*get,eyelid_uy_max,sort,0,max
*get,eyelid_uy_min,sort,0,min
/com,=== EYELID UY range = [%eyelid_uy_min% , %eyelid_uy_max%] m ===
! Max UY on probe (body 4, mat 4)
allsel
esel,s,mat,,4
nsle,s
nsort,u,y
*get,probe_uy_max,sort,0,max
*get,probe_uy_min,sort,0,min
/com,=== PROBE UY range = [%probe_uy_min% , %probe_uy_max%] m ===
allsel
fini
