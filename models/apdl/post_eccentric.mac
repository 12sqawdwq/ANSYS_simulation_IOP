! Eccentric metrics via valid CONT etable items (PRES/STAT)
resume
/post1
set,last

! Contact elements probe-eyelid (real 3)
esel,s,real,,3
esel,r,ename,,174
etable,epr,cont,pres         ! contact pressure (valid)
etable,est,cont,stat         ! status

! Max contact pressure
esort,etab,epr,,1
*get,pmax,etab,0,etab,epr,max

! Count contacting elements (pres > 0) and their node X range
esel,s,real,,3
esel,r,ename,,174
esel,r,etab,epr,1.0,1e12     ! keep elems with pres>=1 Pa (contacting)
*get,n_contact,elem,0,count
nsle,s                       ! nodes of contacting elements
*get,cxmin,node,0,mnloc,x
*get,cxmax,node,0,mxloc,x

! Eyelid peak stress
allsel
esel,s,type,,1
esel,r,mat,,2
nsle,s
nsort,s,eqv
*get,eyelid_s,sort,0,max

! Probe indentation (min UY of probe)
allsel
esel,s,mat,,3
nsle,s
nsort,u,y
*get,probe_uy,sort,0,min
allsel

*cfopen,metrics,txt
*vwrite,pmax
(E15.6)
*vwrite,n_contact
(F10.0)
*vwrite,cxmin
(E15.6)
*vwrite,cxmax
(E15.6)
*vwrite,eyelid_s
(E15.6)
*vwrite,probe_uy
(E15.6)
*cfclos
finish
