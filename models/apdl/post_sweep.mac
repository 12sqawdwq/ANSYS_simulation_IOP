! Metrics for one indentation-sweep case. Values are written in SI units.
/post1
post_time = arg1
*if,post_time,gt,0,then
set,,,,,post_time
*else
set,last
*endif
*get,result_lstep,active,0,set,lstp
*get,result_time,active,0,set,time

! Sum constrained-node reactions on the stable probe top component.
allsel
cmsel,s,probe_top_nodes
*get,probe_node_count,node,0,count
probe_fx = 0
probe_fy = 0
*get,probe_node,node,0,num,min
*do,probe_index,1,probe_node_count
*get,node_fx,node,probe_node,rf,fx
*get,node_fy,node,probe_node,rf,fy
probe_fx = probe_fx + node_fx
probe_fy = probe_fy + node_fy
probe_node = ndnext(probe_node)
*enddo
nsort,u,y
*get,probe_uy_min,sort,0,min
*get,probe_uy_max,sort,0,max

! Closed probe-eyelid contact area and area-weighted global X center.
allsel
etable,eras
esel,s,real,,3
esel,r,ename,,174
etable,opres,cont,pres
etable,opene,cont,pene
etable,ostat,cont,stat
esel,r,etab,ostat,2,3
*get,n_outer,elem,0,count
contact_area = 0
contact_x_center = 0
pmax = 0
max_penetration = 0
*if,n_outer,gt,0,then
etable,carea,volu
etable,centx,cent,x
smult,axprod,carea,centx
ssum
*get,contact_area,ssum,0,item,carea
*get,area_x_sum,ssum,0,item,axprod
*if,contact_area,gt,0,then
contact_x_center = area_x_sum/contact_area
*endif
esort,etab,opres,0,0
*get,pmax,sort,0,max
eusort
esort,etab,opene,0,0
*get,max_penetration,sort,0,max
eusort
*endif

! Material-specific maxima prevent the probe from masking tissue stress.
allsel
esel,s,type,,1
esel,r,mat,,1
nsle,s
nsort,s,eqv
*get,cornea_s,sort,0,max
allsel
esel,s,type,,1
esel,r,mat,,2
nsle,s
nsort,s,eqv
*get,eyelid_s,sort,0,max

*cfopen,metrics,csv
*vwrite,probe_fx,probe_fy,contact_area,contact_x_center,pmax,max_penetration,n_outer,cornea_s,eyelid_s,probe_uy_min,probe_uy_max,result_lstep,result_time
(13(E22.14,','))
*cfclos

! Audit preload and geometry-based first touch after all three load steps exist.
! This keeps the nonlinear solution continuous while still enforcing no-load preload.
set,1,last
allsel
*get,preload_apex_uy_audit,node,eyelid_apex_node_id,u,y
preload_probe_fy = 0
cmsel,s,probe_top_nodes
*get,preload_probe_node_count,node,0,count
*get,preload_probe_node,node,0,num,min
*do,preload_probe_index,1,preload_probe_node_count
*get,preload_node_fy,node,preload_probe_node,rf,fy
preload_probe_fy = preload_probe_fy + preload_node_fy
preload_probe_node = ndnext(preload_probe_node)
*enddo
allsel
etable,eras
esel,s,real,,3
esel,r,ename,,174
etable,plstat,cont,stat
etable,plarea,volu
esel,r,etab,plstat,2,3
*get,preload_contact_count,elem,0,count
preload_contact_area = 0
*if,preload_contact_count,gt,0,then
ssum
*get,preload_contact_area,ssum,0,item,plarea
*endif

set,2,last
approach_probe_fy = 0
allsel
cmsel,s,probe_top_nodes
*get,approach_probe_node_count,node,0,count
*get,approach_probe_node,node,0,num,min
*do,approach_probe_index,1,approach_probe_node_count
*get,approach_node_fy,node,approach_probe_node,rf,fy
approach_probe_fy = approach_probe_fy + approach_node_fy
approach_probe_node = ndnext(approach_probe_node)
*enddo
allsel
etable,eras
esel,s,real,,3
esel,r,ename,,174
etable,apstat,cont,stat
etable,aparea,volu
esel,r,etab,apstat,2,3
*get,approach_contact_count,elem,0,count
approach_contact_area = 0
*if,approach_contact_count,gt,0,then
ssum
*get,approach_contact_area,ssum,0,item,aparea
*endif

*cfopen,load_path,csv
*vwrite,gap0,preload_apex_uy_audit,preload_clearance,approach_push,commanded_push,indent,preload_probe_fy,preload_contact_area,preload_contact_count,approach_probe_fy,approach_contact_area,approach_contact_count
(12(E22.14,','))
*cfclos
set,last
allsel
finish
