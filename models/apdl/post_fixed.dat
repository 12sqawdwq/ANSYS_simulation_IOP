! Which body has the fixed support? Check material of fixed nodes
resume,tonometer_offset,db
/prep7
cmsel,s,_FIXEDSU
*get,nfix,node,0,count
/com,=== Fixed support node count = %nfix% ===
! Get Y-range of fixed nodes
nsort,loc,y
*get,fy_min,sort,0,min
*get,fy_max,sort,0,max
/com,=== Fixed nodes Y-range = [%fy_min% , %fy_max%] m ===
! Check which material: select fixed nodes, find attached elements' material
esln,s,1
esel,r,mat,,1
*get,ne1,elem,0,count
/com,=== Fixed-attached elems with mat 1 (jiamo cornea) = %ne1% ===
allsel
cmsel,s,_FIXEDSU
esln,s,1
esel,r,mat,,2
*get,ne2,elem,0,count
/com,=== Fixed-attached elems with mat 2 (conear) = %ne2% ===
allsel
fini
