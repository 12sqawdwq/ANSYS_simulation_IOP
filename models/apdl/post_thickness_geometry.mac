! Export probe-facing and cornea-facing eyelid faces at preload and indentation.
! Python computes breakpoint-based surface and projected applanation areas.
/post1
rsys,0

set,1,last
allsel
esel,s,real,,3
esel,r,ename,,174
*get,outer_face_count,elem,0,count
*cfopen,outer_preload_faces,csv
outer_elem = elnext(0)
*do,outer_index,1,outer_face_count
outer_n1 = nelem(outer_elem,1)
outer_n2 = nelem(outer_elem,2)
outer_n3 = nelem(outer_elem,3)
*get,outer_x1,node,outer_n1,loc,x
*get,outer_y1,node,outer_n1,loc,y
*get,outer_z1,node,outer_n1,loc,z
*get,outer_ux1,node,outer_n1,u,x
*get,outer_uy1,node,outer_n1,u,y
*get,outer_uz1,node,outer_n1,u,z
*get,outer_x2,node,outer_n2,loc,x
*get,outer_y2,node,outer_n2,loc,y
*get,outer_z2,node,outer_n2,loc,z
*get,outer_ux2,node,outer_n2,u,x
*get,outer_uy2,node,outer_n2,u,y
*get,outer_uz2,node,outer_n2,u,z
*get,outer_x3,node,outer_n3,loc,x
*get,outer_y3,node,outer_n3,loc,y
*get,outer_z3,node,outer_n3,loc,z
*get,outer_ux3,node,outer_n3,u,x
*get,outer_uy3,node,outer_n3,u,y
*get,outer_uz3,node,outer_n3,u,z
outer_dx1 = outer_x1 + outer_ux1
outer_dy1 = outer_y1 + outer_uy1
outer_dz1 = outer_z1 + outer_uz1
outer_dx2 = outer_x2 + outer_ux2
outer_dy2 = outer_y2 + outer_uy2
outer_dz2 = outer_z2 + outer_uz2
outer_dx3 = outer_x3 + outer_ux3
outer_dy3 = outer_y3 + outer_uy3
outer_dz3 = outer_z3 + outer_uz3
*vwrite,outer_elem,outer_n1,outer_n2,outer_n3,outer_dx1,outer_dy1,outer_dz1,outer_dx2,outer_dy2,outer_dz2,outer_dx3,outer_dy3,outer_dz3
(13(E22.14,','))
outer_elem = elnext(outer_elem)
*enddo
*cfclos

allsel
esel,s,real,,4
esel,r,ename,,170
*get,inner_face_count,elem,0,count
*cfopen,inner_preload_faces,csv
inner_elem = elnext(0)
*do,inner_index,1,inner_face_count
inner_n1 = nelem(inner_elem,1)
inner_n2 = nelem(inner_elem,2)
inner_n3 = nelem(inner_elem,3)
*get,inner_x1,node,inner_n1,loc,x
*get,inner_y1,node,inner_n1,loc,y
*get,inner_z1,node,inner_n1,loc,z
*get,inner_ux1,node,inner_n1,u,x
*get,inner_uy1,node,inner_n1,u,y
*get,inner_uz1,node,inner_n1,u,z
*get,inner_x2,node,inner_n2,loc,x
*get,inner_y2,node,inner_n2,loc,y
*get,inner_z2,node,inner_n2,loc,z
*get,inner_ux2,node,inner_n2,u,x
*get,inner_uy2,node,inner_n2,u,y
*get,inner_uz2,node,inner_n2,u,z
*get,inner_x3,node,inner_n3,loc,x
*get,inner_y3,node,inner_n3,loc,y
*get,inner_z3,node,inner_n3,loc,z
*get,inner_ux3,node,inner_n3,u,x
*get,inner_uy3,node,inner_n3,u,y
*get,inner_uz3,node,inner_n3,u,z
inner_dx1 = inner_x1 + inner_ux1
inner_dy1 = inner_y1 + inner_uy1
inner_dz1 = inner_z1 + inner_uz1
inner_dx2 = inner_x2 + inner_ux2
inner_dy2 = inner_y2 + inner_uy2
inner_dz2 = inner_z2 + inner_uz2
inner_dx3 = inner_x3 + inner_ux3
inner_dy3 = inner_y3 + inner_uy3
inner_dz3 = inner_z3 + inner_uz3
*vwrite,inner_elem,inner_n1,inner_n2,inner_n3,inner_dx1,inner_dy1,inner_dz1,inner_dx2,inner_dy2,inner_dz2,inner_dx3,inner_dy3,inner_dz3
(13(E22.14,','))
inner_elem = elnext(inner_elem)
*enddo
*cfclos

! Preload pressure carried by the cornea-side CONTA174 bonded interface.
allsel
etable,eras
esel,s,real,,4
esel,r,ename,,174
etable,ipres,cont,pres
etable,istat,cont,stat
etable,iarea,volu
*get,inner_contact_count,elem,0,count
*cfopen,inner_contact_preload,csv
inner_contact_elem = elnext(0)
*do,inner_contact_index,1,inner_contact_count
*get,inner_contact_pres,elem,inner_contact_elem,etab,ipres
*get,inner_contact_stat,elem,inner_contact_elem,etab,istat
*get,inner_contact_area,elem,inner_contact_elem,etab,iarea
inner_contact_n1 = nelem(inner_contact_elem,1)
inner_contact_n2 = nelem(inner_contact_elem,2)
inner_contact_n3 = nelem(inner_contact_elem,3)
*get,inner_contact_x1,node,inner_contact_n1,loc,x
*get,inner_contact_y1,node,inner_contact_n1,loc,y
*get,inner_contact_z1,node,inner_contact_n1,loc,z
*get,inner_contact_ux1,node,inner_contact_n1,u,x
*get,inner_contact_uy1,node,inner_contact_n1,u,y
*get,inner_contact_uz1,node,inner_contact_n1,u,z
*get,inner_contact_x2,node,inner_contact_n2,loc,x
*get,inner_contact_y2,node,inner_contact_n2,loc,y
*get,inner_contact_z2,node,inner_contact_n2,loc,z
*get,inner_contact_ux2,node,inner_contact_n2,u,x
*get,inner_contact_uy2,node,inner_contact_n2,u,y
*get,inner_contact_uz2,node,inner_contact_n2,u,z
*get,inner_contact_x3,node,inner_contact_n3,loc,x
*get,inner_contact_y3,node,inner_contact_n3,loc,y
*get,inner_contact_z3,node,inner_contact_n3,loc,z
*get,inner_contact_ux3,node,inner_contact_n3,u,x
*get,inner_contact_uy3,node,inner_contact_n3,u,y
*get,inner_contact_uz3,node,inner_contact_n3,u,z
inner_contact_cx = (inner_contact_x1+inner_contact_ux1+inner_contact_x2+inner_contact_ux2+inner_contact_x3+inner_contact_ux3)/3
inner_contact_cy = (inner_contact_y1+inner_contact_uy1+inner_contact_y2+inner_contact_uy2+inner_contact_y3+inner_contact_uy3)/3
inner_contact_cz = (inner_contact_z1+inner_contact_uz1+inner_contact_z2+inner_contact_uz2+inner_contact_z3+inner_contact_uz3)/3
*vwrite,inner_contact_elem,inner_contact_stat,inner_contact_pres,inner_contact_area,inner_contact_cx,inner_contact_cy,inner_contact_cz
(7(E22.14,','))
inner_contact_elem = elnext(inner_contact_elem)
*enddo
*cfclos

post_time = arg1
*if,post_time,gt,0,then
set,,,,,post_time
*else
set,last
*endif
