! Clean geometry query: undeformed Y-extent per body + deformed gap
resume,tonometer_offset,db
/post1
set,last
/com,==== UNDEFORMED (initial) body Y-extents ====
esel,s,mat,,3 $ nsle,s
nsort,loc,y
*get,eyb_ymin,sort,0,min
*get,eyb_ymax,sort,0,max
/com,=== EYELID  initial Y = [%eyb_ymin% , %eyb_ymax%] m ===
allsel $ esel,s,mat,,4 $ nsle,s
nsort,loc,y
*get,prb_ymin,sort,0,min
*get,prb_ymax,sort,0,max
/com,=== PROBE   initial Y = [%prb_ymin% , %prb_ymax%] m ===
/com,==== DEFORMED positions (initial + displacement) ====
! Probe top deformed Y = prb_ymax + UY(top)
allsel $ esel,s,mat,,4 $ nsle,s
! find node at max Y
nsel,r,loc,y,prb_ymax
*get,ptop_node,node,0,num,min
*get,ptop_uy,node,ptop_node,u,y
prb_top_def = prb_ymax + ptop_uy
/com,=== PROBE TOP deformed Y = %prb_top_def% m (node %ptop_node%, uy=%ptop_uy%) ===
! Eyelid bottom deformed
allsel $ esel,s,mat,,3 $ nsle,s
nsel,r,loc,y,eyb_ymin
*get,ebot_node,node,0,num,min
*get,ebot_uy,node,ebot_node,u,y
eyb_bot_def = eyb_ymin + ebot_uy
/com,=== EYELID BOT deformed Y = %eyb_bot_def% m (node %ebot_node%, uy=%ebot_uy%) ===
allsel
fini
