! ============================================================
! PARAMETRIC TONOMETER EYE MODEL - 2D Axisymmetric (centered)
! Cornea (spherical cap) + Eyelid layer + Probe, with IOP.
! All geometry from code. Contact normal correct by construction.
! ============================================================
finish
/clear
/prep7

! ---- Parameters (SI: meters, Pa) ----
Rc      = 7.8e-3       ! cornea outer radius of curvature
tc      = 0.6e-3       ! cornea thickness
te      = 1.0e-3       ! eyelid thickness
Rprobe  = 2.16e-3      ! probe radius
gap0    = 0.15e-3      ! initial probe-eyelid gap
push    = 0.3e-3       ! probe displacement
iop     = 2666.4       ! 20 mmHg in Pa
rmax    = 6.0e-3       ! model radial extent

! ---- Element types ----
et,1,182,,,1           ! PLANE182 axisymmetric
et,2,169               ! target
et,3,172               ! contact

! ---- Materials ----
tb,hyper,1,,2,mooney   ! cornea
tbdata,1,0.11e6,0.025e6,0.1e-6
tb,hyper,2,,2,mooney   ! eyelid
tbdata,1,0.076e6,0.01e6,0.1e-6
mp,ex,3,3500e6         ! probe PLA
mp,nuxy,3,0.33

! ---- Geometry via keypoints & arcs ----
! Cornea: two concentric arcs (outer radius Rc, inner Rc-tc)
! Center of curvature at (0, -Rc) so apex at (0,0)
csys,0

! Angular extent to reach rmax: theta = asin(rmax/Rc)
th = asin(rmax/Rc)
th_deg = th*180/3.14159265

! Cornea OUTER surface keypoints (apex + edge)
k,1,0,0                              ! apex outer
k,2,rmax, -Rc + sqrt(Rc*Rc-rmax*rmax)   ! edge outer
! Cornea INNER surface (radius Rc-tc, same center 0,-Rc)
Rci = Rc - tc
k,3,0,-tc                           ! apex inner
k,4,rmax*Rci/Rc, -Rc + sqrt(Rci*Rci - (rmax*Rci/Rc)**2)  ! edge inner

! Center of curvature keypoint for arcs
k,100,0,-Rc

! Cornea area: arc(1-2) top, line(2-4) edge, arc(3-4) bottom, line(1-3) axis
larc,1,2,100,Rc            ! L1 cornea outer arc
l,2,4                      ! L2 edge
larc,3,4,100,Rci           ! L3 cornea inner arc
l,1,3                      ! L4 axis
al,1,2,3,4                 ! A1 cornea

! Eyelid: sits ON TOP of cornea outer surface (arc L1), thickness te outward
Rce = Rc + te
k,5,0,te                            ! apex eyelid top
k,6,rmax*Rce/Rc, -Rc + sqrt(Rce*Rce-(rmax*Rce/Rc)**2)  ! edge eyelid top
larc,5,6,100,Rce           ! L5 eyelid top arc
l,6,2                      ! L6 edge (eyelid to cornea edge)
! L1 is shared (cornea top = eyelid bottom); axis segment:
l,1,5                      ! L7 axis eyelid
al,5,6,1,7                 ! A2 eyelid (reuse L1)

! Probe: cylinder above eyelid apex, flat bottom (contact normal vertical at apex)
probe_y = te + gap0
k,10,0,probe_y
k,11,Rprobe,probe_y
k,12,Rprobe,probe_y+4e-3
k,13,0,probe_y+4e-3
l,10,11                    ! L8 probe bottom (flat, faces down)
l,11,12                    ! L9
l,12,13                    ! L10
l,13,10                    ! L11 axis
al,8,9,10,11               ! A3 probe

! ---- Mesh ----
esize,0.2e-3
type,1 $ mat,1 $ amesh,1   ! cornea
type,1 $ mat,2 $ amesh,2   ! eyelid
type,1 $ mat,3 $ amesh,3   ! probe
allsel

! ---- Contact: probe bottom (L8) vs eyelid top (L5) ----
r,3
rmod,3,3,1.0               ! FKN
rmod,3,6,-1e-3            ! PINB absolute 1mm
keyopt,3,12,0              ! standard
keyopt,3,9,0
keyopt,3,2,1              ! penalty

! Target on probe bottom
type,2 $ real,3 $ mat,3
lsel,s,line,,8
nsll,s,1
esln,s,0
esurf
allsel
! Contact on eyelid top
type,3 $ real,3 $ mat,2
lsel,s,line,,5
nsll,s,1
esln,s,0
esurf
allsel

! ---- Boundary conditions ----
! Cornea edge fixed (limbus anchor)
lsel,s,line,,2
nsll,s,1
d,all,all,0
allsel
! Symmetry axis
nsel,s,loc,x,0
d,all,ux,0
allsel
! IOP on cornea inner surface (L3)
lsel,s,line,,3
sfl,all,pres,iop
allsel

finish
/solu
antype,static
nlgeom,on
nsubst,20,200,10
outres,all,all
cnvtol,f,,0.05
! Probe top pushed down
nsel,s,loc,y,probe_y+4e-3
d,all,uy,-push
d,all,ux,0
allsel
solve
finish

/post1
set,last
/com,====================================================
nsort,u,y
*get,uymax,sort,0,max
*get,uymin,sort,0,min
/com,=== UY range = [%uymin%, %uymax%] m ===
esel,s,mat,,1 $ nsle,s $ nsort,s,eqv
*get,sc,sort,0,max
/com,=== CORNEA max SEQV = %sc% Pa ===
allsel $ esel,s,mat,,2 $ nsle,s $ nsort,s,eqv
*get,se,sort,0,max
/com,=== EYELID max SEQV = %se% Pa ===
allsel $ esel,s,mat,,3 $ nsle,s $ nsort,s,eqv
*get,sp,sort,0,max
/com,=== PROBE max SEQV = %sp% Pa ===
allsel
esel,s,ename,,172
etable,cst,cont,stat
ssum
*get,cs,ssum,0,item,cst
/com,=== Contact status sum = %cs% (>0=closed) ===
etable,cpr,cont,pres
esort,etab,cpr,,1
*get,cpmax,etab,0,etab,cpr,max
/com,=== Max contact pressure = %cpmax% Pa ===
/com,====================================================
allsel
finish
