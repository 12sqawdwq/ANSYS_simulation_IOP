! ============================================================
! PARAMETRIC 3D TONOMETER SWEEP
! ARG1 = X offset in m
! ARG2 = nominal indentation after the initial gap in m
! ARG3 = encoded execution mode:
!        units = solver retry mode (0=standard, 1=smaller initial steps)
!        tens = experimental local tetra refinement level (0, 1, or 2)
!        hundreds = mesh-only preflight flag (0=solve, 1=stop after mesh)
! ARG4 = background mesh size in m (default 0.3 mm)
! ARG5 = eyelid thickness in m (default 1.0 mm)
! ARG6 = IOP in Pa (0 Pa is a valid zero-IOP case; negative uses 20 mmHg default)
! ARG7 = eyelid C10/C01 scale (default 1.0)
! ARG8 = cornea C10/C01 scale (default 1.0)
! ARG9 = unloaded probe-apex gap in m (default 0.30 mm)
! Experimental local-refinement half-width is frozen at 1.80 mm.
! Known-working config: tet + flat probe + bonded eyelid-cornea
! + IOP preload, geometry-based probe approach, then indentation.
! ============================================================
finish
/clear
/prep7

Rc     = 7.8e-3
tc     = 0.6e-3
te     = ARG5
*if,te,le,0,then
te = 1.0e-3
*endif
*if,te,lt,0.8e-3,then
/com,ERROR: eyelid thickness is below the validated 0.8 mm limit
/exit,nosave
*endif
*if,te,gt,2.0e-3,then
/com,ERROR: eyelid thickness exceeds the validated 2.0 mm limit
/exit,nosave
*endif
Rprobe = 2.16e-3
gap0   = ARG9
*if,gap0,le,0,then
gap0 = 0.30e-3         ! keeps the probe clear during IOP preload
*endif
indent = ARG2
encoded_mode = ARG3
mesh_only_preflight = 0
*if,encoded_mode,ge,100,then
mesh_only_preflight = 1
encoded_mode = encoded_mode-100
*endif
local_refine_level = 0
*if,encoded_mode,ge,20,then
local_refine_level = 2
*else
*if,encoded_mode,ge,10,then
local_refine_level = 1
*endif
*endif
retry_mode = encoded_mode-10*local_refine_level
local_refine_halfwidth = 1.8e-3
mesh_size = ARG4
indent_limit = 0.8e-3
*if,indent,lt,0,then
/com,ERROR: indentation must be non-negative
/exit,nosave
*endif
*if,indent,gt,indent_limit,then
/com,ERROR: indentation exceeds the validated 0.8 mm limit
/exit,nosave
*endif
*if,mesh_size,le,0,then
mesh_size = 0.3e-3
*endif
iop    = ARG6
*if,iop,lt,0,then
iop = 2666.4
*endif
eyelid_material_scale = ARG7
*if,eyelid_material_scale,le,0,then
eyelid_material_scale = 1.0
*endif
cornea_material_scale = ARG8
*if,cornea_material_scale,le,0,then
cornea_material_scale = 1.0
*endif
rmax   = 6.0e-3
xoff   = ARG1
*if,local_refine_level,lt,0,then
/com,ERROR: local refinement level must be 0, 1, or 2
/exit,nosave
*endif
*if,local_refine_level,gt,2,then
/com,ERROR: local refinement level must be 0, 1, or 2
/exit,nosave
*endif
*if,retry_mode,lt,0,then
/com,ERROR: decoded retry mode must be 0 or 1
/exit,nosave
*endif
*if,retry_mode,gt,1,then
/com,ERROR: decoded retry mode must be 0 or 1
/exit,nosave
*endif
*if,mesh_only_preflight,lt,0,then
/com,ERROR: decoded mesh-only flag must be 0 or 1
/exit,nosave
*endif
*if,mesh_only_preflight,gt,1,then
/com,ERROR: decoded mesh-only flag must be 0 or 1
/exit,nosave
*endif

et,1,187              ! SOLID187 tet
et,2,170
et,3,174

tb,hyper,1,,2,mooney
tbdata,1,0.11e6*cornea_material_scale,0.025e6*cornea_material_scale,0.1e-6
tb,hyper,2,,2,mooney
tbdata,1,0.076e6*eyelid_material_scale,0.01e6*eyelid_material_scale,0.1e-6
mp,ex,3,3500e6
mp,nuxy,3,0.33

csys,0
kcen = -Rc

! Cornea section
Rci = Rc - tc
k,1,0,0
k,2,rmax, kcen + sqrt(Rc*Rc-rmax*rmax)
k,3,0,-tc
k,4,rmax*Rci/Rc, kcen + sqrt(Rci*Rci-(rmax*Rci/Rc)**2)
k,100,0,kcen
larc,1,2,100,Rc
l,2,4
larc,3,4,100,Rci
l,1,3
al,1,2,3,4

! Eyelid section
Rce = Rc + te
k,5,0,te
k,6,rmax*Rce/Rc, kcen + sqrt(Rce*Rce-(rmax*Rce/Rc)**2)
larc,5,6,100,Rce
l,6,2
l,1,5
al,5,6,1,7

! Probe section (flat bottom rectangle)
py = te + gap0
k,10,0,py
k,11,Rprobe,py
k,12,Rprobe,py+4e-3
k,13,0,py+4e-3
l,10,11
l,11,12
l,12,13
l,13,10
al,8,9,10,11

! Revolve 360
k,200,0,-1
k,201,0,1
*get,vol_before,volu,0,num,maxd
asel,s,area,,1
vrotat,1,,,,,,200,201,360,4
*get,vol_after,volu,0,num,maxd
vsel,s,volu,,vol_before+1,vol_after
cm,vcornea,volu
allsel
*get,vol_before,volu,0,num,maxd
asel,s,area,,2
vrotat,2,,,,,,200,201,360,4
*get,vol_after,volu,0,num,maxd
vsel,s,volu,,vol_before+1,vol_after
cm,veyelid,volu
allsel
*get,vol_before,volu,0,num,maxd
asel,s,area,,3
vrotat,3,,,,,,200,201,360,4
*get,vol_after,volu,0,num,maxd
vsel,s,volu,,vol_before+1,vol_after
cm,vprobe,volu
allsel

! Offset probe in X
cmsel,s,vprobe
vgen,1,all,,,xoff,,,,,1
allsel

! Mesh and stable probe node components
esize,mesh_size
mshape,1,3d
cmsel,s,vcornea $ vatt,1,,1 $ vmesh,all $ allsel
cmsel,s,veyelid $ vatt,2,,1 $ vmesh,all $ allsel
cmsel,s,vprobe  $ vatt,3,,1 $ vmesh,all $ allsel

! Experimental local refinement is deliberately applied before any nodal
! constraints, contact elements, or persistent node components are created.
! A 1.80 mm central box is intersected with two 0.80 mm-thick Y bands around
! the eyelid-cornea and probe-eyelid paths.  This targets both interfaces and
! the lower probe without refining the full tissue thickness or 6 mm dome.
*get,solid_elements_before_refine,elem,0,count
*get,solid_nodes_before_refine,node,0,count
selected_elements_for_refine = 0
refine_layer_halfheight = 0.40e-3
*if,local_refine_level,gt,0,then
*do,refine_pass,1,local_refine_level
esel,s,type,,1
nsle,s
nsel,r,loc,x,-local_refine_halfwidth,local_refine_halfwidth
nsel,r,loc,z,-local_refine_halfwidth,local_refine_halfwidth
cm,am_central_nodes,node
nsel,r,loc,y,-refine_layer_halfheight,refine_layer_halfheight
cm,am_interface_nodes,node
cmsel,s,am_central_nodes
refine_contact_ymin = te-refine_layer_halfheight
refine_contact_ymax = te+gap0+refine_layer_halfheight
nsel,r,loc,y,refine_contact_ymin,refine_contact_ymax
cmsel,a,am_interface_nodes
esln,s,0
*get,selected_elements_this_pass,elem,0,count
cmdele,am_central_nodes
cmdele,am_interface_nodes
*if,selected_elements_this_pass,lt,1,then
/com,ERROR: local refinement selected no solid elements
/exit,nosave
*endif
selected_elements_for_refine=selected_elements_for_refine+selected_elements_this_pass
erefine,all,1,1
allsel
*enddo
*endif
*get,solid_elements_after_refine,elem,0,count
*get,solid_nodes_after_refine,node,0,count
local_target_size = mesh_size/(2**local_refine_level)

write_aggressive_inventory=local_refine_level+mesh_only_preflight
*if,write_aggressive_inventory,gt,0,then
*cfopen,aggressive_mesh_inventory,csv
*vwrite
('bg_m,target_m,half_m,level,parents,elem_b,elem_a,node_b,node_a')
am_bm=mesh_size
am_tm=local_target_size
am_hw=local_refine_halfwidth
am_lv=local_refine_level
am_sp=selected_elements_for_refine
am_e0=solid_elements_before_refine
am_e1=solid_elements_after_refine
am_n0=solid_nodes_before_refine
am_n1=solid_nodes_after_refine
*vwrite,am_bm,am_tm,am_hw,am_lv,am_sp,am_e0,am_e1,am_n0,am_n1
(8(E22.14,','),E22.14)
*cfclos
*endif

*if,mesh_only_preflight,eq,1,then
save
finish
/exit,nosave
*endif

cmsel,s,vprobe
nslv,s,1
cm,probe_nodes,node
*get,pymax,node,0,mxloc,y
nsel,r,loc,y,pymax-0.6e-3,pymax+0.1e-3
cm,probe_top_nodes,node
allsel

! Stable apex node used to measure IOP-induced elevation before probe approach.
cmsel,s,veyelid
nslv,s,1
nsel,r,loc,x,-0.01e-3,0.01e-3
nsel,r,loc,z,-0.01e-3,0.01e-3
nsel,r,loc,y,te-0.01e-3,te+0.01e-3
*get,eyelid_apex_count,node,0,count
*if,eyelid_apex_count,lt,1,then
/com,ERROR: eyelid apex node was not found
/exit,nosave
*endif
*get,eyelid_apex_node_id,node,0,num,min
cm,eyelid_apex_node,node
allsel

! Contact 1: probe-eyelid standard
r,3
rmod,3,3,1.0
rmod,3,6,-0.5e-3
keyopt,3,12,0
keyopt,3,9,0
keyopt,3,2,1
local,13,2,0,kcen,0
csys,13
cmsel,s,veyelid $ nslv,s,1
nsel,r,loc,x,Rce-0.25e-3,Rce+0.3e-3
csys,0
type,3 $ real,3 $ mat,2 $ esurf
allsel
cmsel,s,probe_nodes
*get,pymin,node,0,mnloc,y
nsel,r,loc,y,pymin-0.01e-3,pymin+0.6e-3
type,2 $ real,3 $ mat,3 $ esurf
allsel

! Contact 2: eyelid-cornea bonded
et,4,170
et,5,174
r,4
keyopt,5,12,5
keyopt,5,2,1
csys,13
cmsel,s,vcornea $ nslv,s,1
nsel,r,loc,x,Rc-0.25e-3,Rc+0.25e-3
csys,0
type,5 $ real,4 $ mat,1 $ esurf
allsel
csys,13
cmsel,s,veyelid $ nslv,s,1
nsel,r,loc,x,Rc-0.25e-3,Rc+0.25e-3
csys,0
type,4 $ real,4 $ mat,2 $ esurf
allsel

! BCs
edge_y = kcen + sqrt(Rc*Rc - rmax*rmax)
cmsel,s,vcornea $ nslv,s,1
nsel,r,loc,y,edge_y-0.5e-3,edge_y+0.4e-3
d,all,all,0
allsel
csys,13
cmsel,s,vcornea $ nslv,s,1
nsel,r,loc,x,Rci-0.2e-3,Rci+0.2e-3
sf,all,pres,iop
csys,0
allsel

finish
/solu
antype,static
nlgeom,on
nropt,full
lnsrch,on
stabilize,constant,energy,1.0e-4
outres,all,all
cnvtol,f,,0.01
ncnv,1
autots,on
kbc,0

! Load step 1: establish IOP prestress with the probe physically separated.
cmsel,s,probe_top_nodes
d,all,ux,0
d,all,uy,0
d,all,uz,0
allsel
time,1
*if,retry_mode,eq,1,then
nsubst,40,400,10
*else
nsubst,20,200,5
*endif
solve
*get,preload_cnv,active,0,solu,cnvg

! Read the converged apex displacement without leaving /SOLU. Leaving the
! solution processor here would restart the nonlinear analysis at zero time.
*get,preload_apex_uy,node,eyelid_apex_node_id,u,y
preload_clearance = gap0 - preload_apex_uy
approach_push = preload_clearance
*if,approach_push,le,0,then
/com,ERROR: initial gap was consumed during IOP preload
/exit,nosave
*endif

! Load step 2: retain IOP and move to geometry-based first touch.
cmsel,s,probe_top_nodes
d,all,uy,-approach_push
allsel
time,2
*if,retry_mode,eq,1,then
nsubst,40,400,10
*else
nsubst,20,200,5
*endif
solve
*get,approach_cnv,active,0,solu,cnvg

! Load step 3: apply the requested indentation from geometric first touch.
commanded_push = approach_push + indent
cmsel,s,probe_top_nodes
d,all,uy,-commanded_push
allsel
time,3
*if,retry_mode,eq,1,then
nsubst,80,800,20
*else
nsubst,40,400,10
*endif
solve
*get,indent_cnv,active,0,solu,cnvg

*cfopen,solution_status,csv
*vwrite,preload_cnv,approach_cnv,indent_cnv
(3(E22.14,','))
*cfclos

save
finish
