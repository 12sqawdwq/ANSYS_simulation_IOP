! Determine contact normal direction of Contact Region 3 (probe-eyelid)
! If normal is ~horizontal (X/Z), vertical push is tangential -> slide-off
resume,tonometer_offset,db
/post1
set,last
! Select target elements of Contact Region 3 (real 10 = TARGE170 on probe)
esel,s,real,,10
esel,r,ename,,170
*get,ntarg,elem,0,count
/com,=== Contact Region 3 target elems (real 10) = %ntarg% ===
! Also the contact elems (real 9 = CONTA174 on eyelid)
allsel
esel,s,real,,9
esel,r,ename,,174
*get,ncont,elem,0,count
/com,=== Contact Region 3 contact elems (real 9) = %ncont% ===
! Get the "gap direction" by comparing centroids of the two contact surfaces.
! Contact surface (eyelid, real 9) centroid:
allsel
esel,s,real,,9
esel,r,ename,,174
nsle,s
*get,c9_x,node,0,mnloc,x
*get,c9_y,node,0,mnloc,y
*get,c9_z,node,0,mnloc,z
/com,=== Contact(eyelid) surf centroid = (%c9_x%, %c9_y%, %c9_z%) m ===
! Target surface (probe, real 10) centroid:
allsel
esel,s,real,,10
esel,r,ename,,170
nsle,s
*get,c10_x,node,0,mnloc,x
*get,c10_y,node,0,mnloc,y
*get,c10_z,node,0,mnloc,z
/com,=== Target(probe) surf centroid = (%c10_x%, %c10_y%, %c10_z%) m ===
! Gap vector = contact - target ; dominant component = normal direction
gx = c9_x - c10_x
gy = c9_y - c10_y
gz = c9_z - c10_z
/com,=== GAP VECTOR (eyelid-probe) = (%gx%, %gy%, %gz%) m ===
/com,=== If |gy| dominates -> head-on (good). If |gx| or |gz| dominates -> tangential slide-off ===
allsel
fini
