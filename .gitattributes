*.py text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf
*.mac text eol=lf
*.dat text eol=lf
*.txt text eol=lf
*.md text eol=lf
*.csv text eol=lf
*.tsv text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.svg text eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
thickness_mesh_independence/aggressive_refinement/results/formal_preflight/** text eol=lf
# Preserve archived failed-attempt bytes exactly where the external evidence used mixed endings.
thickness_mesh_independence/aggressive_refinement/results/failed_p1_resource_guard/iop0/run_manifest.csv -text whitespace=cr-at-eol
thickness_mesh_independence/aggressive_refinement/results/failed_p1_resource_guard/ORPHAN_SOLVER_STOPPED text eol=lf
# Preserve audited endpoint/preflight/abort evidence byte-for-byte. The explicit
# eol unset prevents the global extension rules from rewriting archived CSV bytes.
thickness_mesh_independence/aggressive_refinement/results/accepted_iop0_h2p00/** -text -eol whitespace=-trailing-space
thickness_mesh_independence/aggressive_refinement/results/t1p25_preflight/** -text -eol whitespace=-trailing-space
thickness_mesh_independence/aggressive_refinement/results/t1p25_iop0_user_aborted/** -text -eol whitespace=-trailing-space
thickness_mesh_independence/aggressive_refinement/results/t1p25_iop20_resource_aborted/** -text -eol whitespace=-trailing-space
thickness_mesh_independence/aggressive_refinement/results/t1p25_iop20_ooc_launch/** -text -eol whitespace=-trailing-space

